# =====================================================================
# OpenImperia — variabili d'ambiente di PRODUZIONE
#
# Copiare in `.env` e sostituire i valori "CHANGE_ME".
# In alternativa usare lo script:  ./scripts/gen-prod-env.sh
#
# NON committare mai il file `.env` (è già in .gitignore).
# =====================================================================

# ---------------------------------------------------------------------
# Ambiente
# ---------------------------------------------------------------------
OPENIMPERIA_ENV=production
# I collector girano dentro la rete Docker e parlano con CKAN per nome servizio
CKAN_URL=http://ckan:5000
# Token API di un utente dedicato ai collector (crearlo dopo il primo avvio)
CKAN_API_KEY=CHANGE_ME
CKAN_ORGANIZATION=fablab-imperia-aps
COLLECTOR_HTTP_TIMEOUT=60

# ---------------------------------------------------------------------
# Dominio / HTTPS (Caddy)
# ---------------------------------------------------------------------
# Dominio pubblico del portale (deve puntare al VPS via DNS di tipo A)
CKAN_SITE_URL=https://dati.fablabimperia.org
SITE_ADDRESS=dati.fablabimperia.org
# Email per l'account Let's Encrypt
ACME_EMAIL=fablabimperia@gmail.com

# ---------------------------------------------------------------------
# Database PostgreSQL (DB principale CKAN + DB del DataStore)
# ---------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postgres

CKAN_DB_USER=ckandbuser
CKAN_DB_PASSWORD=CHANGE_ME
CKAN_DB=ckandb

DATASTORE_READONLY_USER=datastore_ro
DATASTORE_READONLY_PASSWORD=CHANGE_ME
DATASTORE_DB=datastore

# URL usati da CKAN (host = nome del servizio nel compose).
# I valori di CHANGE_ME qui sotto devono coincidere con le password sopra.
CKAN_SQLALCHEMY_URL=postgresql://ckandbuser:CHANGE_ME@db/ckandb
CKAN_DATASTORE_WRITE_URL=postgresql://ckandbuser:CHANGE_ME@db/datastore
CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:CHANGE_ME@db/datastore

# ---------------------------------------------------------------------
# CKAN core
# ---------------------------------------------------------------------
CKAN_SITE_ID=default
# Segreto di sessione (generare una stringa casuale lunga)
CKAN___BEAKER__SESSION__SECRET=CHANGE_ME

# Branding del portale
CKAN__SITE_TITLE="Open Data Imperia"
CKAN__SITE_DESCRIPTION="Portale open data del territorio di Imperia"
CKAN__SITE_LOGO=/images/openimperia-logo.svg
CKAN__SITE_INTRO_TEXT="I dati aperti del territorio di Imperia: informazioni pubbliche rilasciate in formati aperti, liberamente riutilizzabili da cittadini, imprese e associazioni."
CKAN__LOCALE_DEFAULT=it
CKAN__LOCALE_ORDER="it en"

# Amministratore creato al primo avvio
CKAN_SYSADMIN_NAME=ckan_admin
CKAN_SYSADMIN_PASSWORD=CHANGE_ME
CKAN_SYSADMIN_EMAIL=fablabimperia@gmail.com

# Plugin abilitati (inclusa l'estensione locale "openimperia")
CKAN__PLUGINS="image_view text_view datatables_view datastore datapusher envvars openimperia"

# ---------------------------------------------------------------------
# Solr
# ---------------------------------------------------------------------
SOLR_IMAGE_VERSION=2.11-solr9
CKAN_SOLR_URL=http://solr:8983/solr/ckan

# ---------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------
REDIS_VERSION=7-alpine
CKAN_REDIS_URL=redis://redis:6379/1

# ---------------------------------------------------------------------
# Datapusher
# ---------------------------------------------------------------------
DATAPUSHER_VERSION=0.0.21
CKAN_DATAPUSHER_URL=http://datapusher:8800
CKAN__DATAPUSHER__CALLBACK_URL_BASE=http://ckan:5000

# ---------------------------------------------------------------------
# Collector containerizzato
# ---------------------------------------------------------------------
COLLECTOR_CRON_SCHEDULE=0 * * * *

# ---------------------------------------------------------------------
# Varie
# ---------------------------------------------------------------------
TZ=Europe/Rome
