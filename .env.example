# =====================================================================
# OpenImperia — variabili d'ambiente
# Copiare in `.env` prima di avviare:  cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# Collector eseguiti sull'host (venv Python, vedi README)
# ---------------------------------------------------------------------
OPENIMPERIA_ENV=development
CKAN_URL=http://localhost:5000
CKAN_API_KEY=CHANGE_ME
CKAN_ORGANIZATION=fablab-imperia-aps
COLLECTOR_HTTP_TIMEOUT=60

# ---------------------------------------------------------------------
# Docker / CKAN — porte host
# ---------------------------------------------------------------------
# Porta del portale CKAN visibile dall'esterno
CKAN_PORT_HOST=5000

# ---------------------------------------------------------------------
# Database PostgreSQL (DB principale CKAN + DB del DataStore)
# ---------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

CKAN_DB_USER=ckandbuser
CKAN_DB_PASSWORD=ckandbpassword
CKAN_DB=ckandb

DATASTORE_READONLY_USER=datastore_ro
DATASTORE_READONLY_PASSWORD=datastore
DATASTORE_DB=datastore

# URL usati da CKAN (host = nome del servizio nel compose)
CKAN_SQLALCHEMY_URL=postgresql://ckandbuser:ckandbpassword@db/ckandb
CKAN_DATASTORE_WRITE_URL=postgresql://ckandbuser:ckandbpassword@db/datastore
CKAN_DATASTORE_READ_URL=postgresql://datastore_ro:datastore@db/datastore

# ---------------------------------------------------------------------
# CKAN core
# ---------------------------------------------------------------------
CKAN_SITE_ID=default
CKAN_SITE_URL=http://localhost:5000
# Cambiare in produzione!
CKAN___BEAKER__SESSION__SECRET=CHANGE_ME

# Branding del portale (equivalenti alle config ckan.site_*)
CKAN__SITE_TITLE="Open Data Imperia"
CKAN__SITE_DESCRIPTION="Portale open data del territorio di Imperia"
CKAN__SITE_LOGO=/images/openimperia-logo.svg
CKAN__SITE_INTRO_TEXT="I dati aperti del territorio di Imperia: informazioni pubbliche rilasciate in formati aperti, liberamente riutilizzabili da cittadini, imprese e associazioni."
CKAN__LOCALE_DEFAULT=it
CKAN__LOCALE_ORDER="it en"

# Amministratore creato al primo avvio
CKAN_SYSADMIN_NAME=ckan_admin
CKAN_SYSADMIN_PASSWORD=admin1234
CKAN_SYSADMIN_EMAIL=fablabimperia@gmail.com

# Plugin abilitati (inclusa l'estensione locale "openimperia")
CKAN__PLUGINS="image_view text_view datatables_view datastore datapusher envvars openimperia"

# ---------------------------------------------------------------------
# Solr
# ---------------------------------------------------------------------
SOLR_IMAGE_VERSION=2.11-solr9
CKAN_SOLR_URL=http://solr:8983/solr/ckan

# ---------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------
REDIS_VERSION=7-alpine
CKAN_REDIS_URL=redis://redis:6379/1

# ---------------------------------------------------------------------
# Datapusher (pubblica le risorse tabulari nel DataStore)
# ---------------------------------------------------------------------
DATAPUSHER_VERSION=0.0.21
CKAN_DATAPUSHER_URL=http://datapusher:8800
CKAN__DATAPUSHER__CALLBACK_URL_BASE=http://ckan:5000

# ---------------------------------------------------------------------
# Collector containerizzato (servizio "collectors" del compose)
# ---------------------------------------------------------------------
# Schedule cron delle esecuzioni automatiche dei collector
COLLECTOR_CRON_SCHEDULE=0 * * * *

# ---------------------------------------------------------------------
# Varie
# ---------------------------------------------------------------------
TZ=Europe/Rome